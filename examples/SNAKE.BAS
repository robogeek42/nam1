01 REM SNAKE in BASIC
02 REM MODE2 32x24 with 16 colours
10 MODE 2 : SCOL 2,1 : CLS
20 POKE $EE,2 : REM turn off scrolling and clear of bottom line
25 N=RND(1234)
30 GOSUB 2000 : REM define characters
40 SW=24 : SH=24
42 SC=0 : DF=1 : SL=23 : REM score, difficulty
44 SL=23 : DL=12 : REM lines to place
46 FT=1
50 GOSUB 3000 : REM draw border
70 DI=1 : REM direction L R D U
72 X=16:Y=12
74 C=0:REM update cntr
80 CURS X,Y:PRINT CHR$($10+DI);

90 TL=1 : REM Tail length
92 TP=0 : REM tail pointer
94 ML=255 : REM Max entries
96 DIM tx(ML): DIM ty(ML): REM tail x/y
98 tx(0)=X+1: ty(0)=Y

100 S$="ANY KEY TO START":GOSUB 3100
102 CURS SW+1,DL+1:PRINT "< > set";
110 C=0
115 GET A$
120 C=C+1
125 IF A$+"X"="X" THEN GOTO 115
130 IF (A$="," OR A$="<") AND DF>1 THEN DF=DF-1
135 IF (A$="." OR A$=">") AND DF<4 THEN DF=DF+1
140 GOSUB 3400
145 IF A$="," OR A$="<" OR A$="." OR A$=">" THEN GOTO 115
150 N=RND(C) : PRINT"C was";C
155 C=0
160 CLS : GOSUB 3000
165 GOSUB 3200 : REM food (FX,FY)

200 REM game loop
210 GET A$
215 C=C+1 : IF C=(70 - 15*DF) THEN GOTO 1000
220 IF A$+"X" = "X" THEN GOTO 200

230 A$=UCASE$(A$) 
240 IF A$="A" THEN DI=1
242 IF A$="D" THEN DI=2
244 IF A$="S" THEN DI=3
246 IF A$="W" THEN DI=4
248 IF A$="Q" THEN GOTO 900

250 GOSUB 400 : REM print snake
260 GOTO 200

400 REM print snake
410 CURS X,Y:PRINT CHR$($10+DI);:REM head
420 CURS tx(TP),ty(TP): PRINT CHR$($17);
430 IF TL=1 THEN RETURN
440 I=(TP-TL+1)AND 255
450 CURS tx(I),ty(I): PRINT CHR$($17);
490 RETURN

800 REM Game over
810 S$="GAME OVER":GOSUB 3100
820 GOTO 970
900 REM quit
960 S$="PRESS ANY KEY":GOSUB 3100
970 A = GETKEY
980 PRINT""
990 POKE $EE,1 : REM turn on scrolling
999 END

1000 REM update state
1010 C=0
1020 CURS X,Y:PRINT " ";
1030 I=(TP-TL+1)AND 255
1040 CURS tx(I),ty(I):PRINT " ";
1050 TP=(TP+1)AND 255
1060 tx(TP)=X:ty(TP)=Y
1070 IF DI=1 THEN X=X-1
1072 IF DI=2 THEN X=X+1
1074 IF DI=3 THEN Y=Y+1
1076 IF DI=4 THEN Y=Y-1
1080 IF X=0 OR X=SW-1 OR Y=0 OR Y=SH-1 THEN GOSUB 1200
1090 IF X=FX AND Y=FY THEN GOSUB 1300
1100 IF SCHAR(X,Y)<>32 THEN GOTO 800
1110 GOTO 250

1200 REM edges
1210 IF X=0 THEN X=SW-2
1212 IF X=SW-1 THEN X=1
1214 IF Y=0 THEN Y=SH-2
1216 IF Y=SH-1 THEN Y=1
1230 RETURN

1300 REM ate food
1310 TL=TL+1
1320 SC=SC+FT
1340 GOSUB 3300
1350 CURS FX,FY:PRINT" ";
1360 GOSUB 3200 : REM new food
1370 RETURN

2000 REM define characters
2005 REM Heads
2010 VDU 23, $11, $0E,$35,$63,$BF,$BF,$63,$35,$0E : REM L
2015 VDU 17, $A1, $11 : REM $A1 = yellow
2020 VDU 23, $12, $70,$AC,$C6,$FD,$FD,$C6,$AC,$70 : REM R
2025 VDU 17, $A1, $12
2030 VDU 23, $13, $7E,$BD,$DB,$99,$5A,$7E,$24,$18 : REM D
2035 VDU 17, $A1, $13
2040 VDU 23, $14, $18,$24,$7E,$5A,$99,$DB,$BD,$7E : REM U
2045 VDU 17, $A1, $14
2050 VDU 23, $15, $00,$3C,$7A,$FD,$FD,$7A,$3C,$00 : REM Bod horiz
2060 VDU 23, $16, $18,$24,$5A,$7E,$7E,$7E,$3C,$18 : REM Bod vert
2070 VDU 23, $17, $3C,$7A,$FD,$FD,$FD,$FF,$7E,$3C : REM Bod round
2080 VDU 23, $18, $00,$3E,$79,$7D,$7F,$1C,$1C,$1C : REM food
2085 VDU 17, $81, $18
2090 VDU 23, $19, $08,$08,$1C,$77,$1C,$08,$08,$00 : REM star 1
2095 VDU 17, $71, $19
2100 VDU 23, $1A, $08,$2A,$1C,$77,$1C,$2A,$08,$00 : REM star 2
2105 VDU 17, $B1, $1A
2110 VDU 23, $1B, $49,$08,$1C,$77,$1C,$08,$49,$00 : REM star 3
2115 VDU 17, $D1, $1B
2120 VDU 17, $41,$1D
2290 RETURN

3000 REM draw border
3010 CURS 0,0
3015 FOR I=1 TO SW:PRINT CHR$($1D);:NEXT
3020 CURS 0,SH-1
3025 FOR I=1 TO SW:PRINT CHR$($1D);:NEXT
3030 FOR I=1 TO SH-2
3032 CURS 0,I:PRINT CHR$($1D);
3034 CURS SW-1,I:PRINT CHR$($1D);
3040 NEXT
3050 CURS SW+1,0: S$=" SNAKE ":GOSUB 3500
3052 CURS SW+3,3:PRINT CHR$($18);" =1";
3054 CURS SW+3,5:PRINT CHR$($19);" =2";
3056 CURS SW+3,7:PRINT CHR$($1A);" =3";
3058 CURS SW+3,9:PRINT CHR$($1B);" =4";
3070 GOSUB 3400 : REM print diff
3075 CURS SW+2,SL-2:PRINT "SCORE";
3080 GOSUB 3300
3090 RETURN

3100 REM print centred
3110 CURS (SW-LEN(S$))/2,SH/2
3120 PRINT S$;
3130 RETURN

3200 REM new food
3205 FT=1 : FR=INT(RND(0)*100)
3210 IF FR>(64-DF*4) THEN FT=FT+1
3212 IF FR>(84-DF*4) THEN FT=FT+1
3214 IF FR>(99-DF*4) THEN FT=FT+1
3220 FX=INT(1+RND(0)*(SW-2))
3230 FY=INT(1+RND(0)*(SH-2))
3240 IF SCHAR(FX,FY)<>32 THEN GOTO 3220
3250 CURS FX,FY
3260 PRINT CHR$($17+FT)
3290 RETURN

3300 REM print score
3310 sp=2
3320 IF SC<1000 THEN sp=3
3330 IF SC<100 THEN sp=4
3340 IF SC<10 THEN sp=5
3350 CURS SW+sp,SL:PRINT SC;
3390 RETURN

3400 REM print difficulty
3405 CURS SW+2,DL
3410 IF DF=1 THEN PRINT " EASY ";
3420 IF DF=2 THEN PRINT "MEDIUM";
3430 IF DF=3 THEN PRINT " HARD ";
3440 IF DF=4 THEN PRINT "CRAZY ";
3490 RETURN

3500 REM print reversed
3510 FOR I=1 TO LEN(S$)
3520 ch=ASC(MID$(S$,I,1))
3530 nc$=CHR$(ch+128)
3540 PRINT nc$;
3550 NEXT
3590 RETURN
